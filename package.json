    "database-gui",
    "sql-studio",
    "vector-database",
    "er-diagram",
    "query-builder",
    "rest-api",
    "ekoni",
    "developer-tools"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node test/sql.test.js",
    "check": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.name==='node_modules'||e.name==='.git'?[]:e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.js')?[path.join(d,e.name)]:[]);const files=walk('.');files.forEach(f=>cp.execFileSync(process.execPath,['--check',f]));console.log('Syntax OK on '+files.length+' JS files');\""
  },
  "homepage": "https://github.com/nadiw1245/ekoni-sql-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadiw1245/ekoni-sql-studio.git"
  },
